{
  "evydencia-session": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node scripts/session-start.mjs",
        "timeout": 5
      }
    ]
  },
  "evydencia-safety": {
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/antigravity-hook.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
