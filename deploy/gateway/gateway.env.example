# TEMPLATE ONLY — copy to /srv/secrets/evydencia-crm-mcp/gateway.env (chmod 0400, owner 1000).
# Never commit the real file. Each operator links their own Sanctum token in the OAuth consent page.
EVYD_PUBLIC_URL=https://mcp-crm.etijucas.com.br
CRM_BASE_URL=https://evydencia.com
# Generate on the VPS: openssl rand -base64 32
EVYD_GATEWAY_KEY=__GENERATE_ON_HOST__
# Comma-separated numeric CRM operator IDs allowed to connect ChatGPT (e.g. 2).
EVYD_ALLOWED_OPERATOR_IDS=__OPERATOR_ID__
# Optional: direct CRM internal read token on evydencia.com (replaces intermediary api.evydencia.com.br)
# EVYD_INTERNAL_READ_TOKEN=__OPTIONAL_INTERNAL_CRM_READ_TOKEN__
# Optional: official Z-API MCP Live bridge (per-operator OAuth 2.1 stored encrypted at EVYD_ZAPI_STORE_PATH)
# EVYD_ZAPI_MCP_ENABLED=1
# EVYD_ZAPI_STORE_PATH=/var/lib/evydencia-mcp/zapi-oauth.enc.json
CRM_REQUEST_TIMEOUT_MS=6000
EVYD_ACCESS_TOKEN_TTL_S=3600
EVYD_REFRESH_TOKEN_TTL_S=2592000
EVYD_OPERATOR_RECHECK_S=300
EVYD_RATE_MCP_PER_MIN=120
EVYD_RATE_AUTH_PER_MIN=20
